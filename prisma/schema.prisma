generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ADMIN / SUPER-ADMIN ====================

model Company {
  id             String   @id
  name           String
  owner          String
  email          String
  mobile         String
  address        String
  city           String
  province       String
  status         String
  password       String
  franchiseCount Int
  createdAt      String
  agreementStart String?
  agreementEnd   String?
}

model Franchise {
  id             String @id
  name           String
  owner          String
  cnic           String
  mobile         String
  email          String
  province       String
  city           String
  package        String
  status         String
  agreementStart String
  agreementEnd   String
  dsm            Int
  dso            Int
  password       String
  companyId      String
  network        String
}

model Employee {
  id          String @id
  name        String
  role        String
  franchise   String
  status      String
  joining     String
  attendance  Int
  performance Int
  mobile      String
  email       String
}

model Payment {
  id        String @id
  franchise String
  amount    String
  method    String
  date      String
  status    String
  package   String
}

model Subscription {
  id         String @id
  name       String
  price      String
  period     String
  features   String
  franchises Int
  color      String
  popular    Boolean
}

model CMSPage {
  id      String @id
  title   String
  status  String
  updated String
  content String
}

model AdminNotification {
  id      String @id
  title   String
  message String
  type    String
  time    String
  read    Boolean
}

model AuditLog {
  id     String @id
  time   String
  user   String
  action String
  detail String
  type   String
}

model AdminSettings {
  id               String @id @default("admin-settings")
  companyName      String
  email            String
  phone            String
  address          String
  smsApiKey        String
  whatsappApiKey   String
  paymentGatewayKey String
  adminName        String
  adminEmail       String
  adminMobile      String
  logo             String
  headerLogo       String
  footerLogo       String
  favicon          String
  header           String
  footer           String
  homepage         String
}

// ==================== AUTH ====================

model User {
  id       String @id
  email    String
  name     String
  role     String
  companyId String?
}

