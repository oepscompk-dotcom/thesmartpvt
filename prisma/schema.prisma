}

model SIMIssueRecord {
  id           String @id
  simIds       String
  issuedTo     String
  issuedToRole String
  issuedById   String
  retailerId   String
  franchiseId  String
  issueDate    String
  returnDate   String
  status       String
  notes        String
}

model Equipment {
  id          String   @id
  name        String
  price       Float
  condition   String
  assignedTo  String
  issueDate   String
  returnDate  String
  status      String
  franchiseId String
