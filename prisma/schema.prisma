  quantity    Int?
}

model EquipmentItemName {
  id          String @id
  name        String
  category    String
  franchiseId String
}

model EquipmentIssueRecord {
  id            String @id
  equipmentId   String
  equipmentName String
  personId      String
  personName    String
  personRole    String
